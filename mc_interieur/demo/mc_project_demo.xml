        <field name="walls_state">unchecked</field>
        <field name="obstacles">Radiator, raam met vensterbank</field>
        <field name="front_material">mdf_lacquer</field>
        <field name="front_color">RAL 7044 zijdegrijs</field>
        <field name="gloss">matt</field>
        <field name="edge_finish">lacquered</field>
        <field name="worktop">stone</field>
        <field name="handles">none</field>
        <field name="hinges">push</field>
        <field name="drawers">premium</field>
        <field name="appliances">Oven, combi-microgolf, vaatwasser, koelkast, inductie, dampkap</field>
        <field name="hood">recirculation</field>
        <field name="sink">under</field>
        <field name="appliance_supply">us</field>
        <field name="installer">us</field>
        <field name="dismantle">yes</field>
        <field name="notes" type="html"><p>Klant wil een eiland met zitgedeelte voor 2 krukken. Werkblad komt van de steenhouwer, opmeting werkblad na plaatsing van de kasten.</p></field>
