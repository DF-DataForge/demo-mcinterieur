        <field name="room">Keuken en berging gelijkvloers</field>
        <field name="situation">renovation</field>
        <field name="desired_date" eval="(DateTime.today() + relativedelta(months=4)).strftime('%Y-%m-%d')"/>
        <field name="budget">20_35</field>
        <field name="third_party">contractor</field>
        <field name="third_party_contact">Bouwbedrijf Mortier, 09 123 45 67</field>
        <field name="space_width">4120</field>
        <field name="space_height">2650</field>
        <field name="space_depth">3240</field>
        <field name="ceiling_height">2650</field>
        <field name="measure_state">todo</field>
