<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <!-- 1. Intake: sales rep just visited the customer -->
    <record id="project_peeters_keuken" model="mc.project">
        <field name="name">Keuken Peeters</field>
        <field name="partner_id" ref="partner_peeters"/>
        <field name="street">Kerkstraat 4</field>
        <field name="city">Aalter</field>
        <field name="user_id" ref="user_sofie"/>
        <field name="project_type_id" ref="project_type_kitchen"/>
        <field name="desired_date" eval="(DateTime.today() + relativedelta(months=4)).strftime('%Y-%m-%d')"/>
        <field name="notes" type="html"><p>Klant wil een eiland met zitgedeelte voor 2 krukken. Werkblad komt van de steenhouwer, opmeting werkblad na plaatsing van de kasten.</p></field>
        <field name="intake_general" eval="{'room': 'Keuken en berging gelijkvloers', 'situation': 'renovation', 'budget': '20_35', 'third_party': 'contractor', 'third_party_contact': 'Bouwbedrijf Mortier, 09 123 45 67'}"/>
        <field name="intake_space" eval="{'space_width': 4120, 'space_height': 2650, 'space_depth': 3240, 'ceiling_height': 2650, 'measure_state': 'todo', 'floor_state': 'todo', 'walls_state': 'unchecked', 'obstacles': 'Radiator, raam met vensterbank'}"/>
        <field name="intake_materials" eval="{'front_material': 'mdf_lacquer', 'front_color': 'RAL 7044 zijdegrijs', 'gloss': 'matt', 'edge_finish': 'lacquered'}"/>
        <field name="intake_hardware" eval="{'handles': 'none', 'hinges': 'push', 'drawers': 'premium'}"/>
        <field name="intake_appliances" eval="{'worktop': 'stone', 'appliances': 'Oven, combi-microgolf, vaatwasser, koelkast, inductie, dampkap', 'hood': 'recirculation', 'sink': 'under', 'appliance_supply': 'us'}"/>
        <field name="intake_installation" eval="{'installer': 'us', 'dismantle': 'yes'}"/>
    </record>

    <!-- 2. Drawing: the drawer works on it, material list from TopSolid is in, one material still unlinked -->
    <record id="project_peeters_inkomkast" model="mc.project">
        <field name="name">Inkomkast Peeters</field>
        <field name="partner_id" ref="partner_peeters"/>
        <field name="city">Aalter</field>
        <field name="user_id" ref="user_sofie"/>
        <field name="drawer_id" ref="user_jonas"/>
        <field name="stage">drawing</field>
        <field name="project_type_id" ref="project_type_wardrobe"/>
        <field name="intake_general" eval="{'room': 'Inkomhal onder de trap', 'situation': 'renovation'}"/>
        <field name="intake_space" eval="{'space_width': 1800, 'space_height': 2450, 'space_depth': 600}"/>
        <field name="intake_materials" eval="{'carcass_material': 'melamine', 'carcass_color': 'Wit', 'front_material': 'veneer', 'front_color': 'Eiken natuur, geolied'}"/>
        <field name="intake_hardware" eval="{'handles': 'profile'}"/>
        <field name="intake_installation" eval="{'installer': 'us'}"/>
    </record>
    <record id="question_peeters_inkomkast_1" model="mc.project.question">
        <field name="project_id" ref="project_peeters_inkomkast"/>
        <field name="name">Wandtype achter de kast?</field>
        <field name="field_name">intake_space.wall_type</field>
    </record>
    <record id="version_peeters_inkomkast_1" model="mc.drawing.version">
        <field name="project_id" ref="project_peeters_inkomkast"/>
        <field name="number">1</field>
        <field name="note">Eerste ontwerp: twee hoge deuren, legplanken binnenin.</field>
        <field name="drawing_image" type="bytes" file="mc_interieur/static/demo/inkomkast_peeters_v1.png"/>
    </record>

    <!-- 3. Customer validation: version 2 waits for the customer, two questions are still open -->
    <record id="project_maes_keuken" model="mc.project">
        <field name="name">Keuken Maes</field>
        <field name="partner_id" ref="partner_maes"/>
        <field name="street">Stationsstraat 12</field>
        <field name="city">Tielt</field>
        <field name="user_id" ref="user_sofie"/>
        <field name="drawer_id" ref="user_jonas"/>
        <field name="stage">drawing</field>
        <field name="project_type_id" ref="project_type_kitchen"/>
        <field name="desired_date" eval="(DateTime.today() + relativedelta(months=2)).strftime('%Y-%m-%d')"/>
        <field name="intake_general" eval="{'room': 'Leefkeuken', 'situation': 'renovation', 'budget': '20_35', 'third_party': 'none'}"/>
        <field name="intake_space" eval="{'space_width': 3240, 'space_height': 2600, 'space_depth': 3800, 'ceiling_height': 2600, 'measure_state': 'done', 'floor_state': 'finished', 'walls_state': 'ok', 'wall_type': 'concrete'}"/>
        <field name="intake_materials" eval="{'carcass_material': 'melamine', 'carcass_color': 'Wit', 'front_material': 'mdf_lacquer', 'front_color': 'RAL 9010 zuiver wit', 'gloss': 'matt', 'grain': 'na', 'edge_finish': 'lacquered'}"/>
        <field name="intake_hardware" eval="{'handles': 'profile', 'hinges': 'softclose', 'drawers': 'premium', 'lighting': 'strip'}"/>
        <field name="intake_appliances" eval="{'worktop': 'stone', 'appliances': 'Oven, combi-microgolf, vaatwasser, koelkast, kookplaat, dampkap', 'fridge_niche': '178', 'hood': 'ceiling', 'sink': 'under', 'appliance_supply': 'us'}"/>
        <field name="intake_installation" eval="{'installer': 'us', 'dismantle': 'yes', 'disposal': 'yes'}"/>
    </record>
    <record id="question_maes_keuken_1" model="mc.project.question">
        <field name="project_id" ref="project_maes_keuken"/>
        <field name="name">Wilt u een stopcontact in een lade (laadstation)?</field>
        <field name="to_customer" eval="True"/>
    </record>
    <record id="question_maes_keuken_2" model="mc.project.question">
        <field name="project_id" ref="project_maes_keuken"/>
        <field name="name">Kleur van de plint: zoals de fronten of inox-look?</field>
        <field name="to_customer" eval="True"/>
    </record>
    <record id="version_maes_keuken_1" model="mc.drawing.version">
        <field name="project_id" ref="project_maes_keuken"/>
        <field name="number">1</field>
        <field name="state">changes</field>
        <field name="note">Eerste ontwerp.</field>
        <field name="customer_remarks">Hoge kast links in plaats van rechts.
Extra lade onder de kookplaat.</field>
        <field name="drawing_image" type="bytes" file="mc_interieur/static/demo/keuken_maes_v1.png"/>
    </record>
    <record id="version_maes_keuken_2" model="mc.drawing.version">
        <field name="project_id" ref="project_maes_keuken"/>
        <field name="number">2</field>
        <field name="note">Opmerkingen van versie 1 verwerkt: kolomkast links, eiland toegevoegd.</field>
        <field name="drawing_image" type="bytes" file="mc_interieur/static/demo/keuken_maes_v2.png"/>
    </record>

    <!-- 4. In production at the CNC -->
    <record id="project_maes_badkamer" model="mc.project">
        <field name="name">Badkamermeubel Maes</field>
        <field name="partner_id" ref="partner_maes"/>
        <field name="city">Tielt</field>
        <field name="user_id" ref="user_sofie"/>
        <field name="drawer_id" ref="user_lien"/>
        <field name="stage">drawing</field>
        <field name="project_type_id" ref="project_type_bathroom"/>
        <field name="intake_general" eval="{'situation': 'renovation'}"/>
        <field name="intake_space" eval="{'access_info': '1ste verdieping, trap 90 cm breed'}"/>
        <field name="intake_materials" eval="{'carcass_material': 'melamine', 'front_material': 'mdf_lacquer', 'front_color': 'RAL 9010'}"/>
        <field name="intake_hardware" eval="{'drawers': 'standard'}"/>
        <field name="intake_appliances" eval="{'worktop': 'stone'}"/>
        <field name="intake_installation" eval="{'installer': 'us'}"/>
    </record>
    <record id="version_maes_badkamer_1" model="mc.drawing.version">
        <field name="project_id" ref="project_maes_badkamer"/>
        <field name="number">1</field>
        <field name="note">Wastafelmeubel met twee lades en spiegelkast.</field>
        <field name="drawing_image" type="bytes" file="mc_interieur/static/demo/badkamer_maes_v1.png"/>
    </record>

    <!-- 5. At the panel saw -->
    <record id="project_vandamme_dressing" model="mc.project">
        <field name="name">Dressing Van Damme</field>
        <field name="partner_id" ref="partner_vandamme"/>
        <field name="street">Coupure 88</field>
        <field name="city">Gent</field>
        <field name="user_id" ref="user_sofie"/>
        <field name="drawer_id" ref="user_jonas"/>
        <field name="stage">drawing</field>
        <field name="project_type_id" ref="project_type_dressing"/>
        <field name="desired_date" eval="(DateTime.today() + relativedelta(days=10)).strftime('%Y-%m-%d')"/>
        <field name="intake_general" eval="{'room': 'Slaapkamer 1', 'situation': 'new'}"/>
        <field name="intake_space" eval="{'access_info': 'Appartement 3de verdieping, lift 1,1 m diep'}"/>
        <field name="intake_materials" eval="{'carcass_material': 'melamine', 'carcass_color': 'Eiken natuur', 'front_material': 'mdf_lacquer', 'front_color': 'NCS S 2005-Y20R'}"/>
        <field name="intake_hardware" eval="{'handles': 'profile', 'lighting': 'sensor', 'layout_wishes': 'Hangroede, schoenenrek, broekenrek'}"/>
        <field name="intake_installation" eval="{'installer': 'us', 'parking': 'Laadzone voor de deur, vooraf aanvragen bij de stad'}"/>
    </record>
    <record id="version_vandamme_dressing_1" model="mc.drawing.version">
        <field name="project_id" ref="project_vandamme_dressing"/>
        <field name="number">1</field>
        <field name="note">Dressing met drie deuren en open kast.</field>
        <field name="drawing_image" type="bytes" file="mc_interieur/static/demo/dressing_vandamme_v1.png"/>
    </record>

    <!-- 6. Work preparation: approved, waiting in a draft cutting batch with a material shortage -->
    <record id="project_vandamme_tv" model="mc.project">
        <field name="name">TV-wand Van Damme</field>
        <field name="partner_id" ref="partner_vandamme"/>
        <field name="city">Gent</field>
        <field name="user_id" ref="user_sofie"/>
        <field name="drawer_id" ref="user_jonas"/>
        <field name="stage">drawing</field>
        <field name="project_type_id" ref="project_type_tv"/>
        <field name="intake_general" eval="{'situation': 'new'}"/>
        <field name="intake_materials" eval="{'carcass_material': 'melamine', 'carcass_color': 'Antraciet', 'front_material': 'mdf_lacquer'}"/>
        <field name="intake_hardware" eval="{'lighting': 'strip'}"/>
        <field name="intake_installation" eval="{'installer': 'us'}"/>
    </record>
    <record id="version_vandamme_tv_1" model="mc.drawing.version">
        <field name="project_id" ref="project_vandamme_tv"/>
        <field name="number">1</field>
        <field name="note">Lowboard met wandpaneel en LED-strip.</field>
        <field name="drawing_image" type="bytes" file="mc_interieur/static/demo/tvwand_vandamme_v1.png"/>
    </record>

    <!-- 7. Assembly and installation planned -->
    <record id="project_desmet_bureau" model="mc.project">
        <field name="name">Bureau-kast De Smet</field>
        <field name="partner_id" ref="partner_desmet"/>
        <field name="street">Markt 3</field>
        <field name="city">Eeklo</field>
        <field name="user_id" ref="user_sofie"/>
        <field name="drawer_id" ref="user_lien"/>
        <field name="stage">drawing</field>
        <field name="project_type_id" ref="project_type_desk"/>
        <field name="intake_general" eval="{'situation': 'renovation'}"/>
        <field name="intake_space" eval="{'access_info': '2de verdieping, lift aanwezig'}"/>
        <field name="intake_materials" eval="{'carcass_material': 'melamine', 'carcass_color': 'Eiken'}"/>
        <field name="intake_hardware" eval="{'handles': 'handles', 'handle_model': 'Lijngreep zwart 160 mm', 'drawers': 'standard', 'lighting': 'strip'}"/>
        <field name="intake_installation" eval="{'installer': 'us', 'dismantle': 'no', 'disposal': 'no', 'parking': 'Parkeerplaats voor de deur', 'utilities': 'Door klant geregeld'}"/>
    </record>
    <record id="version_desmet_bureau_1" model="mc.drawing.version">
        <field name="project_id" ref="project_desmet_bureau"/>
        <field name="number">1</field>
        <field name="note">Bureau met ladeblok en boekenkast.</field>
        <field name="drawing_image" type="bytes" file="mc_interieur/static/demo/bureau_desmet_v1.png"/>
    </record>

    </data>

    <!-- Parts lists, quotes, approvals, cutting batches, stock and installations.
         Outside the noupdate block so it also runs when demo data is loaded later or on an upgrade;
         the method itself skips when it already ran. -->
    <function model="mc.project" name="_mc_demo_setup"/>
</odoo>
