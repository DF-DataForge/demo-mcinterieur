    <record id="partner_supplier_plates" model="res.partner">
        <field name="name">Plaatgroothandel Vlaanderen</field>
        <field name="is_company" eval="True"/>
        <field name="email">bestel@plaatgroothandel.example.com</field>
        <field name="city">Kortrijk</field>
        <field name="country_id" ref="base.be"/>
    </record>
