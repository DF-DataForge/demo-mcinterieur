        <field name="mc_thickness">18</field>
        <field name="standard_price">48</field>
        <field name="sale_ok" eval="False"/>
        <field name="seller_ids" eval="[Command.create({'partner_id': ref('partner_supplier_plates'), 'price': 48, 'delay': 3})]"/>
    </record>
