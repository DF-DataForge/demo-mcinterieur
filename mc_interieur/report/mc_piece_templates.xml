<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Content of one label: code as Code128 barcode plus what the workshop reads by eye -->
    <template id="report_mc_piece_label_content">
        <t t-set="part" t-value="piece.part_id"/>
        <div class="o_mc_label_top">
            <span class="o_mc_label_customer" t-out="piece.project_id.partner_id.name"/>
            <span class="o_mc_label_ref" t-out="piece.project_id.ref"/>
        </div>
        <div class="o_mc_label_name">
            <t t-out="part.name"/>
            <span class="o_mc_label_cabinet" t-if="part.cabinet"> - <t t-out="part.cabinet"/></span>
        </div>
        <div class="o_mc_label_meta">
            <t t-out="part.length"/> x <t t-out="part.width"/> x <t t-out="'%g' % part.thickness"/> mm
            - <t t-out="part.product_id.default_code or part.topsolid_material"/>
            <t t-if="part.grain"> - nerf</t>
        </div>
        <div class="o_mc_label_meta" t-if="part._mc_edge_label()">Kant: <t t-out="part._mc_edge_label()"/></div>
        <div class="o_mc_label_meta" t-if="part.cnc_program">CNC: <t t-out="part.cnc_program"/></div>
        <div class="o_mc_label_barcode" t-out="piece.barcode"
             t-options="{'widget': 'barcode', 'symbology': 'Code128', 'width': 600, 'height': 110, 'quiet': 0, 'img_style': 'width:100%;height:13mm;'}"/>
        <div class="o_mc_label_code" t-out="piece.barcode"/>
    </template>

    <template id="report_mc_piece_label_style">
        <style>
            .o_mc_label { box-sizing: border-box; overflow: hidden; font-family: Arial, Helvetica, sans-serif; color: #000; }
            .o_mc_label_top { font-size: 8pt; border-bottom: 1px solid #000; padding-bottom: 0.5mm; overflow: hidden; }
            .o_mc_label_customer { float: right; }
            .o_mc_label_ref { font-weight: bold; }
            .o_mc_label_name { font-size: 11.5pt; font-weight: bold; margin-top: 0.8mm; line-height: 1.15; }
            .o_mc_label_cabinet { font-weight: normal; }
            .o_mc_label_meta { font-size: 7.5pt; line-height: 1.25; }
            .o_mc_label_barcode { margin-top: 0.8mm; }
            .o_mc_label_code { font-family: monospace; font-size: 8.5pt; text-align: center; letter-spacing: 0.3px; }
        </style>
    </template>

    <!-- One label per page, for a label printer with 100 x 50 mm labels -->
    <template id="report_mc_piece_label">
        <t t-call="web.html_container">
            <t t-call="mc_interieur.report_mc_piece_label_style"/>
            <t t-foreach="docs" t-as="piece">
                <div class="o_mc_label" style="width: 100mm; height: 50mm; padding: 2.5mm 3mm; page-break-after: always;">
                    <t t-call="mc_interieur.report_mc_piece_label_content"/>
                </div>
            </t>
        </t>
    </template>

    <!-- A4 sheet with 2 x 7 labels of 105 x 42 mm, for an office printer -->
    <template id="report_mc_piece_label_a4">
        <t t-call="web.html_container">
            <t t-call="mc_interieur.report_mc_piece_label_style"/>
            <div style="width: 210mm; padding-top: 1.5mm;">
                <t t-foreach="docs" t-as="piece">
                    <div class="o_mc_label" style="float: left; width: 105mm; height: 42mm; padding: 2mm 4mm; page-break-inside: avoid;">
                        <t t-call="mc_interieur.report_mc_piece_label_content"/>
                    </div>
                    <div t-if="piece_index % 14 == 13 and not piece_last" style="clear: both; page-break-after: always;"/>
                </t>
                <div style="clear: both;"/>
            </div>
        </t>
    </template>
</odoo>
