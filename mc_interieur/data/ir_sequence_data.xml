<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_mc_project" model="ir.sequence">
        <field name="name">Interieurproject</field>
        <field name="code">mc.project</field>
        <field name="prefix">PRJ-%(year)s-</field>
        <field name="padding">4</field>
        <field name="number_next">150</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_mc_cutting_batch" model="ir.sequence">
        <field name="name">Zaagbatch</field>
        <field name="code">mc.cutting.batch</field>
        <field name="prefix">ZB-%(year)s-</field>
        <field name="padding">3</field>
        <field name="number_next">45</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
