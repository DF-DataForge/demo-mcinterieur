<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mc_project_view_list" model="ir.ui.view">
        <field name="name">mc.project.view.list</field>
        <field name="model">mc.project</field>
        <field name="arch" type="xml">
            <list string="Interieurprojecten">
                <field name="ref"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="city" optional="show"/>
                <field name="project_type_id" optional="show"/>
                <field name="stage" widget="badge"/>
                <field name="intake_progress" widget="progressbar" decoration-success="True" optional="show"/>
                <field name="open_question_count" optional="show"/>
                <field name="desired_date" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="drawer_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Pipeline: same card as the mockup (name, customer and town, type, open questions, intake bar, files, people) -->
    <record id="mc_project_view_kanban" model="ir.ui.view">
        <field name="name">mc.project.view.kanban</field>
        <field name="model">mc.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" highlight_color="color" sample="1" class="o_mc_kanban" group_create="0">
                <field name="stage"/>
                <field name="open_question_count"/>
                <field name="attachment_count"/>
                <field name="quote_count"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold o_mc_card_title"/>
                        <div class="small text-muted">
                            <field name="partner_id"/><t t-if="record.city.raw_value"> · <field name="city"/></t>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <field name="project_type_id" widget="badge" class="o_mc_badge"/>
                            <span t-if="record.open_question_count.raw_value" class="badge rounded-pill o_mc_badge_warn">
                                <t t-out="record.open_question_count.raw_value"/> open
                                <t t-if="record.open_question_count.raw_value == 1">vraag</t><t t-else="">vragen</t>
                            </span>
                        </div>
                        <field name="intake_progress" widget="progressbar" decoration-success="True" class="mt-2 o_mc_progress"/>
                        <footer class="pt-2 small text-muted">
                            <span class="me-2" title="Foto's en plannen">
                                <i class="oi me-1" data-icon="photo_camera" role="img" aria-label="Foto's en plannen"/><t t-out="record.attachment_count.raw_value"/>
                            </span>
                            <span t-if="record.quote_count.raw_value" title="Offertes">
                                <i class="oi me-1" data-icon="description" role="img" aria-label="Offertes"/><t t-out="record.quote_count.raw_value"/>
                            </span>
                            <div class="ms-auto d-flex gap-1">
                                <field name="user_id" widget="many2one_avatar_user"/>
                                <field name="drawer_id" widget="many2one_avatar_user"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="mc_project_view_search" model="ir.ui.view">
        <field name="name">mc.project.view.search</field>
        <field name="model">mc.project</field>
        <field name="arch" type="xml">
            <search string="Interieurprojecten">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('ref', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="city"/>
                <filter name="my_projects" string="Mijn projecten"
                        domain="['|', ('user_id', '=', uid), ('drawer_id', '=', uid)]"/>
                <separator/>
                <filter name="stage_intake" string="Intake" domain="[('stage', '=', 'intake')]"/>
                <filter name="stage_drawing" string="Tekening" domain="[('stage', '=', 'drawing')]"/>
                <filter name="stage_validation" string="Klantvalidatie" domain="[('stage', '=', 'validation')]"/>
                <filter name="stage_production" string="In productie"
                        domain="[('stage', 'in', ('prep', 'sawing', 'cnc', 'assembly'))]"/>
                <separator/>
                <filter name="with_questions" string="Met open vragen" domain="[('question_ids.done', '=', False)]"/>
                <group>
                    <filter name="group_stage" string="Fase" context="{'group_by': 'stage'}"/>
                    <filter name="group_partner" string="Klant" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'project_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Project form: intake per theme as tabs with chips, like the mockup -->
    <record id="mc_project_view_form" model="ir.ui.view">
        <field name="name">mc.project.view.form</field>
        <field name="model">mc.project</field>
        <field name="arch" type="xml">
            <form string="Interieurproject" class="o_mc_project_form">
                <header>
                    <button name="action_handoff_drawer" type="object" string="Doorsturen naar tekenaar"
                            class="btn-primary" icon="edit" invisible="stage != 'intake'"
                            confirm="Lege intakevragen worden open vragen voor de tekenaar. Doorsturen?"/>
                    <button name="action_open_topsolid_import" type="object" string="TopSolid-materiaallijst inlezen"
                            icon="upload" invisible="stage not in ('drawing', 'validation') or piece_ids"/>
                    <button name="action_generate_quote" type="object" string="Offerte genereren"
                            icon="calculate" invisible="stage not in ('drawing', 'validation') or not part_ids"/>
                    <button name="action_send_to_customer" type="object" string="Tekening + offerte naar klant"
                            class="btn-primary" icon="send" invisible="stage != 'drawing'"/>
                    <button name="action_view_portal" type="object" string="Bekijk als klant" icon="visibility"
                            invisible="stage == 'intake'"/>
                    <button name="action_plan_installation" type="object" string="Plaatsing plannen" icon="calendar_today"
                            invisible="stage not in ('prep', 'sawing', 'cnc', 'assembly')"/>
                    <field name="stage" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_questions" type="object" class="oe_stat_button" icon="help">
                            <field name="open_question_count" widget="statinfo" string="Open vragen"/>
                        </button>
                        <button name="action_view_quotes" type="object" class="oe_stat_button" icon="description">
                            <field name="quote_count" widget="statinfo" string="Offertes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <div class="o_mc_ref"><field name="ref" readonly="1"/></div>
                        <h1><field name="name" placeholder="bv. Keuken Peeters"/></h1>
                    </div>
                    <group class="o_mc_head">
                        <group>
                            <field name="partner_id" placeholder="Naam klant"/>
                            <field name="city" placeholder="Gemeente werf"/>
                            <field name="street" placeholder="Adres werf"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="drawer_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <div class="o_mc_intake d-flex flex-wrap align-items-center gap-3 mb-3">
                        <field name="intake_progress" widget="progressbar" decoration-success="True" readonly="1"
                               class="o_mc_intake_bar" nolabel="1"/>
                        <div class="o_mc_intake_text flex-grow-1">
                            <b><field name="intake_answered" class="d-inline" readonly="1"/> van
                            <field name="intake_total" class="d-inline" readonly="1"/></b> intakevragen beantwoord<span
                            invisible="not open_question_count">, <b><field name="open_question_count" class="d-inline" readonly="1"/></b> open vragen</span>.
                            Niets is verplicht: wat ontbreekt, blokkeert het doorsturen niet en wordt een open vraag voor de tekenaar.
                        </div>
                    </div>

                    <notebook>
                        <page string="Algemeen" name="intake_general">
                            <field name="intake_hidden_keys" invisible="1"/>
                            <group>
                                <group>
                                    <field name="project_type_id" widget="badges_many2one" options="{'no_create': True}"/>
                                    <field name="desired_date"/>
                                </group>
                                <group>
                                    <field name="intake_template_id" groups="mc_interieur.mc_interieur_group_manager"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                            <p class="text-muted small mb-2">Vragen en keuzes beheer je onder Configuratie &gt; Intakevragen. Een beheerder kan hier ook rechtstreeks een vraag toevoegen of aanpassen.</p>
                            <field name="intake_general" nolabel="1" columns="2"/>
                        </page>
                        <page string="Ruimte &amp; opmeting" name="intake_space">
                            <p class="text-muted small mb-2">Vragen en keuzes beheer je onder Configuratie &gt; Intakevragen. Een beheerder kan hier ook rechtstreeks een vraag toevoegen of aanpassen.</p>
                            <field name="intake_space" nolabel="1" columns="2"/>
                        </page>
                        <page string="Materialen &amp; afwerking" name="intake_materials">
                            <p class="text-muted small mb-2">Vragen en keuzes beheer je onder Configuratie &gt; Intakevragen. Een beheerder kan hier ook rechtstreeks een vraag toevoegen of aanpassen.</p>
                            <field name="intake_materials" nolabel="1" columns="2"/>
                        </page>
                        <page string="Beslag &amp; indeling" name="intake_hardware">
                            <p class="text-muted small mb-2">Vragen en keuzes beheer je onder Configuratie &gt; Intakevragen. Een beheerder kan hier ook rechtstreeks een vraag toevoegen of aanpassen.</p>
                            <field name="intake_hardware" nolabel="1" columns="2"/>
                        </page>
                        <page string="Werkblad &amp; toestellen" name="intake_appliances" invisible="not show_appliances">
                            <p class="text-muted small mb-2">Vragen en keuzes beheer je onder Configuratie &gt; Intakevragen. Een beheerder kan hier ook rechtstreeks een vraag toevoegen of aanpassen.</p>
                            <field name="intake_appliances" nolabel="1" columns="2"/>
                        </page>
                        <page string="Plaatsing" name="intake_installation">
                            <p class="text-muted small mb-2">Vragen en keuzes beheer je onder Configuratie &gt; Intakevragen. Een beheerder kan hier ook rechtstreeks een vraag toevoegen of aanpassen.</p>
                            <field name="intake_installation" nolabel="1" columns="2"/>
                        </page>
                        <page string="Foto's &amp; plannen" name="media">
                            <p class="text-muted">Op tablet of gsm opent "Bestanden toevoegen" meteen de camera. Schets op papier: foto nemen.</p>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Notities &amp; vragen" name="questions">
                            <field name="question_ids">
                                <list editable="bottom" decoration-muted="done">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="to_customer" widget="boolean_toggle"/>
                                    <field name="answer"/>
                                    <field name="answered_by_customer" optional="hide"/>
                                    <field name="field_name" optional="hide"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <p class="text-muted small">
                                Zet "In klantportaal" aan om een vraag aan de klant te stellen. Zolang zo'n vraag open
                                staat, kan de klant tekening en offerte niet goedkeuren.
                            </p>
                            <separator string="Notities intakegesprek"/>
                            <field name="notes" placeholder="Wensen, gewoontes, wat de klant belangrijk vindt"/>
                        </page>
                        <page string="Overzicht tekenaar" name="drawer_overview">
                            <div class="o_mc_box mb-3">
                                <h5>Start in TopSolid</h5>
                                <p class="text-muted mb-2">Gebruik de projectreferentie als naam van het TopSolid-project. Dan kan de
                                    materiaallijst later automatisch aan dit project gekoppeld worden, en via Odoo naar Ardis.</p>
                                <group>
                                    <field name="topsolid_folder" widget="CopyClipboardChar" readonly="1"/>
                                    <field name="ref" string="Projectreferentie" widget="CopyClipboardChar" readonly="1"/>
                                </group>
                            </div>
                            <separator string="Samenvatting intake"/>
                            <field name="intake_summary_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Tekening" name="drawing">
                            <field name="version_ids" context="{'default_project_id': id}">
                                <list>
                                    <field name="number"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'pending'" decoration-success="state == 'approved'"
                                           decoration-warning="state == 'changes'"/>
                                    <field name="note"/>
                                    <field name="shared_on"/>
                                    <field name="approved_by"/>
                                    <field name="approved_on"/>
                                </list>
                                <form string="Tekeningversie">
                                    <group>
                                        <group>
                                            <field name="number"/>
                                            <field name="state"/>
                                            <field name="note"/>
                                        </group>
                                        <group>
                                            <field name="drawing_pdf" filename="drawing_pdf_name"/>
                                            <field name="drawing_pdf_name" invisible="1"/>
                                            <field name="shared_on"/>
                                            <field name="approved_by"/>
                                            <field name="approved_on"/>
                                        </group>
                                    </group>
                                    <field name="drawing_image" widget="image" class="w-100"/>
                                    <group string="Opmerkingen klant" invisible="not customer_remarks">
                                        <field name="customer_remarks" nolabel="1" colspan="2"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Offerte" name="quote">
                            <div class="alert alert-secondary" role="status" invisible="part_ids">
                                Nog geen TopSolid-materiaallijst. Lees ze in via "TopSolid-materiaallijst inlezen";
                                daarna genereer je hier de offerte met één klik.
                            </div>
                            <group invisible="not part_ids">
                                <group>
                                    <field name="quote_margin"/>
                                    <field name="quote_margin_external"/>
                                    <field name="quote_discount"/>
                                    <field name="quote_deposit"/>
                                </group>
                                <group>
                                    <field name="quote_install_days"/>
                                    <field name="quote_worktop_amount"/>
                                    <field name="quote_appliance_amount"/>
                                    <field name="quote_vat" widget="badges_selection"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                            <field name="quote_preview_html" nolabel="1" readonly="1" invisible="not part_ids"/>
                            <field name="sale_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="mc_version_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total" sum="Totaal"/>
                                    <field name="state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Onderdelen (TopSolid)" name="parts">
                            <div class="d-flex flex-wrap gap-2 mb-2 align-items-center">
                                <button name="action_open_topsolid_import" type="object" string="TopSolid-materiaallijst inlezen"
                                        class="btn-primary" invisible="piece_ids"/>
                                <button name="action_relink_materials" type="object" string="Materiaalkoppeling opnieuw toepassen"
                                        class="btn-secondary" invisible="not part_ids"/>
                                <span class="text-muted" invisible="not parts_imported_on">
                                    Ingelezen op <field name="parts_imported_on" class="d-inline" readonly="1"/>
                                </span>
                            </div>
                            <field name="part_ids" context="{'default_project_id': id}">
                                <list editable="bottom" decoration-warning="not product_id">
                                    <field name="sequence" widget="handle"/>
                                    <field name="cabinet"/>
                                    <field name="name"/>
                                    <field name="topsolid_material"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="length"/>
                                    <field name="width"/>
                                    <field name="thickness"/>
                                    <field name="quantity"/>
                                    <field name="grain" optional="show"/>
                                    <field name="edge_l1_id" optional="hide"/>
                                    <field name="edge_l2_id" optional="hide"/>
                                    <field name="edge_w1_id" optional="hide"/>
                                    <field name="edge_w2_id" optional="hide"/>
                                    <field name="cnc_program" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Productie" name="production" invisible="stage in ('intake', 'drawing', 'validation')">
                            <group>
                                <group>
                                    <field name="piece_progress"/>
                                    <field name="batch_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="installation_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <separator string="Picklijst beslag"/>
                            <field name="hardware_html" nolabel="1" readonly="1"/>
                            <separator string="Etiketten"/>
                            <div class="mb-2" invisible="not piece_ids">
                                <button name="action_print_labels" type="object" string="Etiketten printen (Odoo)"
                                        icon="print" class="btn-secondary"/>
                                <span class="text-muted ms-2">Terugvaloptie als Ardis of de zaag de etiketten niet print.</span>
                            </div>
                            <field name="piece_ids" readonly="1">
                                <list>
                                    <field name="barcode"/>
                                    <field name="cabinet"/>
                                    <field name="name"/>
                                    <field name="sawn"/>
                                    <field name="needs_cnc" optional="hide"/>
                                    <field name="cnc_done"/>
                                    <field name="kitted"/>
                                    <field name="assembled"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mc_project_question_view_list" model="ir.ui.view">
        <field name="name">mc.project.question.view.list</field>
        <field name="model">mc.project.question</field>
        <field name="arch" type="xml">
            <list string="Open vragen" editable="bottom" decoration-muted="done">
                <field name="project_id" column_invisible="context.get('default_project_id')"/>
                <field name="name"/>
                <field name="to_customer" widget="boolean_toggle"/>
                <field name="answer"/>
                <field name="done" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mc_project_question_view_search" model="ir.ui.view">
        <field name="name">mc.project.question.view.search</field>
        <field name="model">mc.project.question</field>
        <field name="arch" type="xml">
            <search string="Open vragen">
                <field name="name"/>
                <field name="project_id"/>
                <filter name="open" string="Open" domain="[('done', '=', False)]"/>
                <filter name="customer" string="In klantportaal" domain="[('to_customer', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="mc_project_action" model="ir.actions.act_window">
        <field name="name">Interieurprojecten</field>
        <field name="res_model">mc.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="mc_project_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start een nieuw project bij het klantbezoek</p>
            <p>De verkoper vult de intake in, neemt foto's en stuurt het project door naar de tekenaar.</p>
        </field>
    </record>
</odoo>
