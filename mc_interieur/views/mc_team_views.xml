<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mc_team_view_list" model="ir.ui.view">
        <field name="name">mc.team.view.list</field>
        <field name="model">mc.team</field>
        <field name="arch" type="xml">
            <list string="Plaatsingsploegen" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="mc_team_action" model="ir.actions.act_window">
        <field name="name">Plaatsingsploegen</field>
        <field name="res_model">mc.team</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
